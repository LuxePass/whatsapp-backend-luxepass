# Environment
NODE_ENV=production
PORT=3500
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require&channel_binding=require&schema=wa

# Meta / WhatsApp Cloud API
META_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=replace-with-phone-number-id
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_API_VERSION=v22.0
WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token

# Marketing template settings
META_MARKETING_TEMPLATE_NAME=marketing_update
META_MARKETING_TEMPLATE_LANGUAGE=en

# App URLs
ALLOWED_ORIGINS=https://frontend-luxepass.onrender.com
CORE_BACKEND_URL=https://backend-luxepass-sruf.onrender.com/api/v1
MEDIA_BASE_URL=https://storage.googleapis.com/<bucket>
APP_URL=https://whatsapp-backend-luxepass.onrender.com
RENDER_EXTERNAL_URL=https://whatsapp-backend-luxepass.onrender.com
# For deployed public base URL and webhook display
# Use either APP_URL or RENDER_EXTERNAL_URL on Render, or the appropriate host env for your platform.
# APP_URL=https://your-whatsapp-backend.example.com
# RENDER_EXTERNAL_URL=https://your-whatsapp-backend.onrender.com

# Internal service auth (MUST match backend WHATSAPP_BACKEND_SECRET)
CORE_BACKEND_INTERNAL_SECRET=replace-with-shared-internal-secret
WHATSAPP_BACKEND_SECRET=replace-with-shared-internal-secret

# Optional: used in referral link generation
WHATSAPP_PHONE_NUMBER=+2340000000000
