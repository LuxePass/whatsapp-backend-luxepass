{
	"name": "whatsapp-backend",
	"version": "1.0.0",
	"description": "Production-grade WhatsApp Business Cloud API backend",
	"type": "module",
	"main": "server.ts",
	"scripts": {
		"start": "tsx server.ts",
		"dev": "tsx watch server.ts",
		"typecheck": "tsc --noEmit",
		"db:setup": "prisma generate && prisma db push",
		"db:generate": "prisma generate",
		"db:migrate": "prisma db push",
		"db:studio": "prisma studio",
		"prisma:generate": "prisma generate",
		"prisma:db:push": "prisma db push",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"whatsapp",
		"business-api",
		"webhook",
		"meta"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@prisma/client": "^6.19.0",
		"axios": "^1.6.2",
		"cors": "^2.8.5",
		"crypto": "^1.0.1",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-rate-limit": "^7.1.4",
		"helmet": "^7.1.0",
		"winston": "^3.11.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"@vitest/coverage-v8": "^3.2.4",
		"prisma": "^6.19.0",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
